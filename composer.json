{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Ready to use Laravel admin panel.",
    "keywords": [
        "framework",
        "laravel",
        "admin panel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "alexusmai/laravel-file-manager": "^3.1",
        "arcanedev/log-viewer": "^11.0",
        "atymic/twitter": "^3.3",
        "aws/aws-sdk-php": "^3.337",
        "codiksh/version": "^11.0.0",
        "darkaonline/l5-swagger": "^11.0",
        "doctrine/dbal": "^3.0 || ^4.0",
        "facebook/graph-sdk": "^5.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^11.0",
        "laravel/passport": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.20",
        "laravel/tinker": "^2.9",
        "laracasts/flash": "^3.2",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.29",
        "prabowosd/laravel-collective-html": "^1.1",
        "razorpay/razorpay": "^2.9",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "yajra/laravel-datatables": "^11.0",
        "yajra/laravel-datatables-oracle": "^11.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "spatie/laravel-ignition": "^2.4",
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^2.0",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
